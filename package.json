{
    "name": "voice-ai-exotel-bridge",
    "version": "1.0.0",
    "scripts": {
        "build": "tsc && mkdir -p dist/public && cp src/public/*.html dist/public/",
        "start": "NODE_ENV=production node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "docker-compose:run": "docker-compose up -d --build"
    },
    "dependencies": {
        "axios": "^1.6.4",
        "form-data": "^4.0.0",
        "body-parser": "^1.20.2",
        "@openai/agents": "^0.3.4",
        "dotenv": "^16.4.0",
        "express": "^4.21.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "@types/ws": "^8.5.10",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.0"
    }
}