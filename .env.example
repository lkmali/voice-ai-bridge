# Server
APP_PORT=8080
PUBLIC_HOST=https://your.public.domain   # used for building StreamUrl host

# Exotel
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SID=your_exotel_sid
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=0113083XXXX
# The StreamUrl Exotel will connect to (WSS). Must be reachable by Exotel.
EXOTEL_STREAM_PATH=/exotel-media
# When you assemble, something like: wss://your.public.domain/exotel-media

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12

# Misc
NODE_ENV=development
